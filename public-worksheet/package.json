{
  "name": "me-u-private-reflection",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:check": "npm run lint && npm run typecheck && npm run build && npm test && npm run audit:release && git diff --check",
    "audit:release": "npm audit --audit-level=high",
    "browser:check": "playwright test --project=desktop-chromium --project=android-chromium --project=iphone-webkit",
    "demo:record": "playwright test --config=playwright.demo.config.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@cloudflare/vite-plugin": "1.70.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5"
  }
}
